{
  "name": "backend",
  "version": "1.0.0",
  "main": "src/main.js",
  "type": "module",
  "scripts": {
    "start": "node src/main.js",
    "dev": "node --watch src/main.js",
    "test": "node --test test/unit/*.test.js test/contract/*.test.js test/integration/*.test.js test/e2e/*.test.js",
    "test:unit": "node --test test/unit/*.test.js",
    "test:contract": "node --test test/contract/*.test.js",
    "test:integration": "node --test test/integration/*.test.js",
    "test:e2e": "node --test test/e2e/*.test.js",
    "test:watch": "node --test --watch",
    "test:load": "node --test --test-timeout=180000 test/load/*.test.js",
    "test:chaos": "node --test --test-timeout=120000 test/chaos/*.test.js",
    "test:live": "node --env-file-if-exists=.env --test --test-timeout=180000 test/live/*.test.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "NovaGPT backend \u2014 multi-model AI platform",
  "dependencies": {
    "@node-rs/argon2": "^2.0.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "ioredis": "^5.11.1",
    "mongoose": "^9.7.3",
    "prom-client": "^15.1.3",
    "ulid": "^3.0.2",
    "zod": "^4.4.3"
  }
}

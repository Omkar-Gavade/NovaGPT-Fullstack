# ── Core ────────────────────────────────────────────────────────────────
# The only required variable. Everything else has a documented default, so the
# platform boots from this alone.
MONGODB_URI=your_mongodb_connection_string
PORT=8080
HOST=0.0.0.0
NODE_ENV=development
PUBLIC_URL=http://localhost:5173

# ── Logging ─────────────────────────────────────────────────────────────
# debug | info | warn | error | silent
LOG_LEVEL=info
# Human-readable output. Defaults on outside production, off inside it.
# LOG_PRETTY=true

# ── Cache (optional, required for more than one instance) ───────────────
# Without it the platform uses an in-process cache, which is correct for a
# single instance. With two or more, rate limits and circuit-breaker state
# would be per-instance — see docs/backend/15-decisions.md (ADR-014).
# REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=nova:

# ── HTTP ────────────────────────────────────────────────────────────────
BODY_LIMIT=1mb
# Comma-separated allowlist, or * for any origin.
CORS_ORIGINS=*
REQUEST_TIMEOUT_MS=300000

# ── Providers ───────────────────────────────────────────────────────────
# A provider is enabled by having its credential, not by being named here.
# The allowlist is the exception, for a deployment that wants to pin exactly
# which providers may run. Empty means "no restriction".
# PROVIDERS_ENABLED=groq,gemini
# Applied after the allowlist and beats it, so an operator can take a provider
# out during an incident without editing a list configured months ago.
# PROVIDERS_DISABLED=
# Recovery polling. Only probes providers that are NOT healthy, so this is not
# a per-provider request rate.
PROVIDER_HEALTH_INTERVAL_MS=60000
PROVIDER_PROBE_TIMEOUT_MS=8000
# Consecutive transient failures before the breaker opens. `quota` and `auth`
# ignore this and open on the first failure.
PROVIDER_FAILURE_THRESHOLD=3

# Test adapter. Makes no network calls and serves scripted responses; set it
# only in development. No real provider adapters exist yet — Phase 3.
# MOCK_PROVIDER_ENABLED=1

# ── Observability ───────────────────────────────────────────────────────
METRICS_ENABLED=true
# Must not be reachable from the public internet until admin auth lands
# (Phase 6). Restrict it at the ingress.
METRICS_PATH=/api/v1/admin/metrics
# METRICS_DEFAULT_LABELS=region=eu-west-1,tier=prod

# ── Lifecycle ───────────────────────────────────────────────────────────
# Time to finish in-flight requests after SIGTERM.
SHUTDOWN_GRACE_MS=30000
# Time between going unready and closing the listener, so the load balancer
# stops routing before connections start being refused. Set to 0 locally.
SHUTDOWN_DRAIN_DELAY_MS=5000

# ── Build metadata (injected by CI) ─────────────────────────────────────
# SERVICE_VERSION=1.4.2
# GIT_COMMIT=abc1234
# BUILD_TIME=2026-07-29T10:00:00Z

# ══ Legacy app (server.js) ══════════════════════════════════════════════
# Consumed by the pre-migration monolith only. The new provider framework
# reads none of these yet — its adapters land in Phase 3, at which point these
# keys move up into the Providers section above.

GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
KIMI_API_KEY=            # Moonshot; MOONSHOT_API_KEY also accepted
QWEN_API_KEY=            # Alibaba DashScope; DASHSCOPE_API_KEY also accepted
GROQ_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=

# ── Free-tier providers (Phase 6) ─────────────────────────────────────────
# All permanently free or free developer tiers. Add any subset.
CEREBRAS_API_KEY=        # cloud.cerebras.ai — ~1M tokens/day free
GITHUB_MODELS_TOKEN=     # a GitHub PAT — models.github.ai (free)
NVIDIA_API_KEY=          # build.nvidia.com — free evaluation (40 req/min)
COHERE_API_KEY=          # dashboard.cohere.com — trial key (~100 req/day)
ZHIPU_API_KEY=           # open.bigmodel.cn — GLM-4-Flash free
HF_TOKEN=                # huggingface.co — free serverless inference
# Cloudflare Workers AI needs BOTH:
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Local / self-hosted (no key needed) ─────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434/v1

# Any OpenAI-compatible endpoint ──────────────────────────────────────────
CUSTOM_BASE_URL=
CUSTOM_API_KEY=

# Optional endpoint overrides ─────────────────────────────────────────────
# OPENAI_BASE_URL=https://api.openai.com/v1

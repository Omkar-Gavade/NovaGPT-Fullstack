# ── Core ────────────────────────────────────────────────────────────────
# The only required variable. Everything else has a documented default, so the
# platform boots from this alone.
MONGODB_URI=mongodb+srv://user:user@cluster0.pjispov.mongodb.net/?appName=Cluster0
PORT=8080
HOST=0.0.0.0
NODE_ENV=development
PUBLIC_URL=http://localhost:5173

# ── Logging ─────────────────────────────────────────────────────────────
# debug | info | warn | error | silent
LOG_LEVEL=info
# Human-readable output. Defaults on outside production, off inside it.
# LOG_PRETTY=true

# ── Cache (optional, required for more than one instance) ───────────────
# Without it the platform uses an in-process cache, which is correct for a
# single instance. With two or more, rate limits and circuit-breaker state
# would be per-instance — see docs/backend/15-decisions.md (ADR-014).
# REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=nova:

# ── HTTP ────────────────────────────────────────────────────────────────
BODY_LIMIT=1mb
# Comma-separated allowlist, or * for any origin.
CORS_ORIGINS=*
REQUEST_TIMEOUT_MS=300000

# ── Providers ───────────────────────────────────────────────────────────
# A provider is enabled by having its credential, not by being named here.
# The allowlist is the exception, for a deployment that wants to pin exactly
# which providers may run. Empty means "no restriction".
# PROVIDERS_ENABLED=groq,gemini
# Applied after the allowlist and beats it, so an operator can take a provider
# out during an incident without editing a list configured months ago.
# PROVIDERS_DISABLED=
# Shipped dark: configured and reachable, but ranked LAST, so a new provider
# receives traffic only as a late failover while it accumulates real telemetry
# with a bounded blast radius. Step 9 of onboarding; step 10 removes it from
# this list after 48h of clean telemetry.
PROVIDERS_DARK=qwen,ollama
# When each entered observation, so the promotion gate can measure the window.
# PROVIDERS_DARK_SINCE=qwen=2026-08-04T00:00:00Z
# Recovery polling. Only probes providers that are NOT healthy, so this is not
# a per-provider request rate.
PROVIDER_HEALTH_INTERVAL_MS=60000
PROVIDER_PROBE_TIMEOUT_MS=8000
# Consecutive transient failures before the breaker opens. `quota` and `auth`
# ignore this and open on the first failure.
PROVIDER_FAILURE_THRESHOLD=3

# Test adapter. Makes no network calls and serves scripted responses; set it
# only in development.
# MOCK_PROVIDER_ENABLED=1

# ── Authentication (docs/backend/10-security.md#authentication) ─────────
# On by default. Turning it off leaves every conversation endpoint open to
# unauthenticated callers; production refuses to boot with it off.
AUTH_REQUIRED=true
AUTH_ALLOW_REGISTRATION=true

# RS256 key pair, PEM. Required in production. Left unset outside production,
# an ephemeral pair is generated at boot — which invalidates every token on
# restart and cannot be verified by a second instance.
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out jwt.key
#   openssl rsa -pubout -in jwt.key -out jwt.pub
# Literal \n sequences are accepted, because most secret stores cannot carry a
# real newline in a variable.
# JWT_PRIVATE_KEY=
# JWT_PUBLIC_KEY=
# Accepted but not used for signing, so a rotation does not invalidate every
# token in flight (docs/backend/10-security.md#rotation).
# JWT_PREVIOUS_PUBLIC_KEY=
JWT_ISSUER=novagpt
JWT_AUDIENCE=novagpt-api

# Short enough that a stolen access token expires before it is worth much.
AUTH_ACCESS_TTL_MS=900000
AUTH_REFRESH_TTL_MS=2592000000
AUTH_COOKIE_NAME=nova_refresh
# AUTH_COOKIE_DOMAIN=novagpt.app
# Defaults to on in production. Off is for plain-HTTP local development only —
# a Secure cookie is never sent over HTTP, so the flow would silently fail.
# AUTH_COOKIE_SECURE=false

# Length beats composition rules: `Passw0rd!` satisfies every class
# requirement and is weaker than a longer passphrase.
PASSWORD_MIN_LENGTH=12
# Escalating backoff, not a hard lock: a permanent lock hands an attacker a
# denial-of-service primitive against any address they know.
LOGIN_LOCKOUT_THRESHOLD=5
LOGIN_LOCKOUT_BASE_MS=30000
LOGIN_LOCKOUT_MAX_MS=900000

# 32 random bytes, base64. Wraps the per-record data keys that encrypt
# user-supplied provider keys. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# ENCRYPTION_MASTER_KEY=

# ── Rate limiting (docs/backend/10-security.md#rate-limiting) ───────────
# Per IP, unauthenticated. Defends scraping and enumeration.
RATE_LIMIT_ANONYMOUS_PER_MINUTE=30
# Per IP, sign-in routes. Fails CLOSED when the counter store is unreachable.
RATE_LIMIT_AUTH_PER_MINUTE=10
# Per user. Defends the shared provider quota. Fails OPEN.
RATE_LIMIT_CHAT_PER_MINUTE=20
RATE_LIMIT_CHAT_PER_HOUR=300

# ── Observability ───────────────────────────────────────────────────────
METRICS_ENABLED=true
# Requires the admin permission. The first registered account is the
# operator's; restrict this at the ingress as well.
METRICS_PATH=/api/v1/admin/metrics
# METRICS_DEFAULT_LABELS=region=eu-west-1,tier=prod

# Prompt and completion text in the logs. OFF, and it stays off unless an
# operator turns it on deliberately — at which point the decision is written to
# the audit log. A flag someone flips and forgets is the difference between a
# debugging tool and a liability.
LOG_CONTENT=false

# ── Tracing (docs/backend/11-observability.md#tracing) ──────────────────
TRACING_ENABLED=true
# The share of *ordinary successful* requests kept. Errors, failovers and slow
# requests are kept at 100% regardless — sampling those away defeats the reason
# traces exist.
TRACE_SAMPLE_RATE=0.05
# At or above this, a request counts as slow and is kept in full. A fixed number
# rather than a live p95, because a percentile computed from the traces you kept
# is circular.
TRACE_SLOW_MS=5000
# Bounds one trace, so a retry storm cannot grow it without limit. Dropped spans
# are counted, so a truncated trace says so.
TRACE_MAX_SPANS=200

# ── Lifecycle ───────────────────────────────────────────────────────────
# Time to finish in-flight requests after SIGTERM.
SHUTDOWN_GRACE_MS=30000
# Time between going unready and closing the listener, so the load balancer
# stops routing before connections start being refused. Set to 0 locally.
SHUTDOWN_DRAIN_DELAY_MS=5000

# ── Build metadata (injected by CI) ─────────────────────────────────────
# SERVICE_VERSION=1.4.2
# GIT_COMMIT=abc1234
# BUILD_TIME=2026-07-29T10:00:00Z

# ══ Provider credentials ════════════════════════════════════════════════
# A provider is enabled by having its credential. Add any subset; the router
# uses whatever is configured and routes around whatever is not.

GEMINI_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
QWEN_API_KEY=            # Alibaba DashScope; DASHSCOPE_API_KEY also accepted
MISTRAL_API_KEY=
OPENROUTER_API_KEY=

NVIDIA_API_KEY=          # build.nvidia.com — free evaluation tier
ZHIPU_API_KEY=           # open.bigmodel.cn — GLM-4-Flash free

# ── Local inference ─────────────────────────────────────────────────────
# The one provider enabled by an ENDPOINT rather than a key: there is no
# credential to have. Setting this is the deliberate act that says "there is an
# Ollama here" — unset, the adapter is skipped exactly as an unkeyed provider is.
# Adds the one failure-independence axis nothing else has: it keeps working when
# the network does not (docs/backend/15-decisions.md ADR-026).
# OLLAMA_BASE_URL=http://localhost:11434
